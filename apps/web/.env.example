# Copy to .env.local and fill in from your Supabase project.
# Project URL: Project Settings > Data API (or the Connect button). Looks like https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Project Settings > API Keys > Publishable key (sb_publishable_...). Never use the secret key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The public URL of the site, used for email links (http://localhost:3000 locally).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Set to true after enabling the Google provider in Supabase.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# --- Premium payments (Stripe). Leave empty to keep payments switched off. ---
# Stripe dashboard > Developers > API keys > Secret key (sk_test_... while testing). Server only.
STRIPE_SECRET_KEY=
# Stripe dashboard > Product catalog > Premium > the price IDs (price_...).
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
# Stripe dashboard > Developers > Webhooks > your endpoint > Signing secret (whsec_...).
STRIPE_WEBHOOK_SECRET=
# Supabase > Project Settings > API Keys > Secret key (sb_secret_...). Server only, never NEXT_PUBLIC.
# Used only to record payments. Paste it into Vercel yourself; never share it.
SUPABASE_SECRET_KEY=

# Contact email shown on the privacy policy and terms pages (optional).
NEXT_PUBLIC_CONTACT_EMAIL=
